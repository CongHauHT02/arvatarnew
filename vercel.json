{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*).jar",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/java-archive"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ]
}
